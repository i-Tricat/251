<?xml version="1.0" encoding="UTF-8"?>
<launch>
  <!-- ===== 공통 카메라 인자 ===== -->
  <arg name="device"   default="/dev/v4l/by-id/usb-SunplusIT_Inc_FHD_Camera_Microphone_01.00.00-video-index0"/>
  <arg name="width"    default="1280"/>
  <arg name="height"   default="720"/>
  <arg name="fps"      default="30"/>
  <arg name="pixel"    default="yuyv"/>  <!-- yuyv에서 프레임 안 뜨면 mjpeg로 변경 -->
  <!-- 반드시 file:/// 형태의 절대경로 -->
  <arg name="yaml_url" default="file:///home/i-tricat241/catkin_ws/src/tricat/tricat_251/params/ost.yaml"/>

  <!-- ===== 입력 모드 선택 =====
       true  : usb_cam 노드가 장치 소유, navigator.py는 이미지 토픽 구독(권장)
       false : navigator.py가 장치 직접 오픈(usb_cam과 동시 사용 금지)
  -->
  <arg name="use_ros_image" default="true"/>
  <arg name="image_topic"   default="/usb_cam/image_raw"/>

  <!-- ===== usb_cam / image_proc (use_ros_image=true일 때만 실행) ===== -->
  <node if="$(arg use_ros_image)" pkg="usb_cam" type="usb_cam_node" name="usb_cam" output="screen">
    <param name="video_device"    value="$(arg device)"/>
    <param name="image_width"     value="$(arg width)"/>
    <param name="image_height"    value="$(arg height)"/>
    <param name="framerate"       value="$(arg fps)"/>
    <param name="pixel_format"    value="$(arg pixel)"/>
    <param name="camera_name"     value="usb_cam"/>
    <param name="camera_info_url" value="$(arg yaml_url)"/>
  </node>

  <node if="$(arg use_ros_image)" pkg="image_proc" type="image_proc" name="image_proc" ns="usb_cam" output="screen"/>

  <!-- ===== TRICAT Nodes ===== -->
  <!-- navigator.py: PD 네비게이터 -->
  <node pkg="tricat_251" type="navigator.py" name="wb" output="screen" respawn="true">
    <!-- 모드 전환 파라미터 -->
    <param name="use_ros_image" value="$(arg use_ros_image)"/>
    <param name="image_topic"   value="$(arg image_topic)"/>

    <!-- (옵션) 장치 직접 오픈 모드에서만 사용 -->
    <param name="camera_device" value="$(arg device)"/>
    <param name="width"  value="$(arg width)"/>
    <param name="height" value="$(arg height)"/>

    <!-- (필요 시) 탐지/제어 파라미터도 여기서 조정하세요 -->
    <!--
    <param name="hfov_deg"       value="78.0"/>
    <param name="vfov_deg"       value="50.0"/>
    <param name="buoy_height_m"  value="1.0"/>
    <param name="min_area"       value="800"/>
    <param name="kp_px"          value="0.0025"/>
    <param name="kd_px"          value="0.0100"/>
    <param name="k_yaw_pwm"      value="300.0"/>
    <param name="fwd_pwm"        value="120"/>
    <param name="max_delta_pwm"  value="400"/>
    <param name="topic_left"     value="/thruster/left_us"/>
    <param name="topic_right"    value="/thruster/right_us"/>
    -->
  </node>

  <!-- 추진기 제어 노드 -->
  <node pkg="tricat_251" type="actuator.py"  name="actuator" output="screen"/>

  <!-- 아두이노 직결을 쓰실 경우만 해제 -->
  <node pkg="tricat_251" type="serial_node.py" name="ARDUINO" args="/dev/ttyARDUINO" respawn="true"/>
</launch>
